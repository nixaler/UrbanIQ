# Vent-app's own Supabase project — NOT the trivia game's or Intellectus's project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/session-mode Postgres connection string (Supabase: Project Settings >
# Database > Connection string > "Session" mode, port 5432 — NOT the 6543
# transaction-pooled one). Used by Drizzle; the matcher needs real
# multi-statement transactions with row locks (FOR UPDATE SKIP LOCKED), which
# transaction-mode pooling breaks.
DATABASE_URL=

# Daily.co (managed WebRTC rooms/tokens). Server-only — never expose to the client.
DAILY_API_KEY=
DAILY_DOMAIN=

# Stripe (Phase 4: micro-donations + charity Connect payouts). Not required
# until NEXT_PUBLIC_DONATIONS_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Comma-separated list of Supabase auth user IDs allowed into /admin/moderation-queue.
ADMIN_USER_IDS=

# Public base URL, used for Stripe Checkout success/cancel redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron shared secret, checked by api/cron/* routes.
CRON_SECRET=

# Feature flags — see src/lib/config/featureFlags.ts. All default to "off" in
# code; set explicitly once the feature is ready to show.
NEXT_PUBLIC_KARMA_ENABLED=false
NEXT_PUBLIC_DONATIONS_ENABLED=false
NEXT_PUBLIC_CAMERA_MASKING_ENABLED=false
