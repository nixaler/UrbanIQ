# Intellectus own Supabase project — NOT the trivia game's project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string (Supabase: Project Settings > Database).
# Used by Drizzle; must be a plain TCP connection, not a pooled/HTTP one,
# since the app currently runs entirely on the Node.js runtime (see
# src/lib/db/client.ts for why edge-compatible driver swap is deferred).
DATABASE_URL=

# AI text pipeline (lib/ai/provider.ts). Defaults to the Anthropic adapter.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Inngest (background jobs / content pipeline orchestration).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Ambient audio narration (lib/ai/tts/provider.ts). Defaults to ElevenLabs.
# Synthetic AI voice only, per the confirmed product decision — no real
# recorded/cloned human voice.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stripe (subscriptions, weekend vault, and Connect payouts for tipping).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
NEXT_PUBLIC_STRIPE_PREMIUM_PRICE_ID=

# Upstash Redis (rate limiting: Devil's Advocate daily-use, shadow-ban counters).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature flags — see src/lib/config/featureFlags.ts. All default to "off";
# only flip these once the underlying business/legal precondition is met
# (see the risk notes in INTELLECTUS_PLAN.md).
NEXT_PUBLIC_PAYWALL_ENABLED=false
NEXT_PUBLIC_TIPPING_ENABLED=false
NEXT_PUBLIC_STAKING_REAL_MONEY_ENABLED=false

# Vercel Cron shared secret, checked by api/cron/* routes.
CRON_SECRET=
